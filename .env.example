# Copy to .env and fill in. Everything here is read by backend/app/core/config.py.

# --- Database (docker compose publishes Postgres on host port 5435) ---
POSTGRES_USER=intake
POSTGRES_PASSWORD=intake
POSTGRES_DB=document_intake
DATABASE_URL=postgresql+psycopg://intake:intake@localhost:5435/document_intake

# --- Claude ---
# Without a key the API still starts; documents fail processing with a clear error.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Auth ---
# Any long random string; e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Demo reviewer created on startup (synthetic data only).
DEMO_USER_EMAIL=reviewer@example.com
DEMO_USER_PASSWORD=change-me-too
